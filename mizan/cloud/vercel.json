{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/sync.mjs --check || echo 'lib copies not checked (repo sources unavailable)'",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/v1/:path*", "has": [{ "type": "host", "value": "mizan.api.cuddleia.com" }], "destination": "https://api.cuddleia.com/mizan/v1/:path*", "statusCode": 308 },
    { "source": "/", "has": [{ "type": "host", "value": "mizan.api.cuddleia.com" }], "destination": "https://api.cuddleia.com/mizan/v1", "statusCode": 308 },
    { "source": "/mcp", "has": [{ "type": "host", "value": "mizan.mcp.cuddleia.com" }], "destination": "https://mcp.cuddleia.com/mizan", "statusCode": 308 },
    { "source": "/", "has": [{ "type": "host", "value": "mizan.mcp.cuddleia.com" }], "destination": "https://mcp.cuddleia.com/", "statusCode": 308 }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "mcp.cuddleia.com" }], "destination": "/api/mcp-info" },
    { "source": "/", "destination": "/api/catalog" },
    { "source": "/mizan", "has": [{ "type": "host", "value": "mcp.cuddleia.com" }], "destination": "/api/mcp" },
    { "source": "/mizan/mcp", "destination": "/api/mcp" },
    { "source": "/mizan", "destination": "/api/v1?route=" },
    { "source": "/mizan/v1", "destination": "/api/v1?route=" },
    { "source": "/mizan/v1/:route*", "destination": "/api/v1?route=:route*" },
    { "source": "/serambi", "has": [{ "type": "host", "value": "mcp.cuddleia.com" }], "destination": "https://pms.cuddleia.com/api/public/mcp" },
    { "source": "/serambi/mcp", "destination": "https://pms.cuddleia.com/api/public/mcp" },
    { "source": "/serambi", "destination": "https://pms.cuddleia.com/api/public/v1" },
    { "source": "/serambi/v1", "destination": "https://pms.cuddleia.com/api/public/v1" },
    { "source": "/serambi/v1/staff", "destination": "https://pms.cuddleia.com/api/staff/v1" },
    { "source": "/serambi/v1/staff/:path*", "destination": "https://pms.cuddleia.com/api/staff/v1/:path*" },
    { "source": "/serambi/v1/:path*", "destination": "https://pms.cuddleia.com/api/public/v1/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
